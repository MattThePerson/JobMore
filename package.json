{
  "name": "jobmore",
  "version": "1.0.0",
  "description": "Track job applications",
  "license": "ISC",
  "author": "mstirl",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server",
    "dev": "node --watch src/server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npm run format:check -- --write",
    "format:check": "prettier --check \"{src,shared,frontend}/**/*.{ts,tsx}\"",
    "tsc": "tsc --noEmit",
    "check:front": "npm --prefix frontend run check",
    "check:back": "concurrently --names lint,tsc,format \"npm:lint\" \"npm:tsc\" \"npm:format:check\"",
    "check": "concurrently --names back,frnt \"npm:check:back\" \"npm:check:front\"",
    "install:frontend": "npm --prefix frontend ci",
    "install:all": "npm ci && npm run install:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "setup": "npm run install:all && npm run build:all",
    "test": "echo \"Testing not yet setup\"",
    "prepare": "husky",
    "boop": "echo \"BOOP\""
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
