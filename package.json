{
  "name": "jobmore",
  "version": "1.0.0",
  "description": "Track job applications",
  "license": "ISC",
  "author": "mstirl",
  "type": "module",
  "scripts": {
    "build": "",
    "start:prod": "",
    "start:test": "",
    "dev": "node --watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"{src,shared,frontend}/**/*.{ts,tsx}\"",
    "format:fix": "npm run format -- --write",
    "tsc": "tsc --noEmit",
    "check:frontend": "npm --prefix frontend run check",
    "check": "concurrently --names lint,format,tsc,fe \"npm:lint\" \"npm:format\" \"npm:tsc\" \"npm:check:frontend\"",
    "check:nofe": "concurrently --names lint,format,tsc \"npm:lint\" \"npm:format\" \"npm:tsc\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "boop": "echo \"BOOP\""
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
